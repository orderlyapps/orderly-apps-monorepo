  "-Ionic Modal": {
    "isFileTemplate": true,
    "prefix": "ionic",
    "body": [
      "import { useCardModal } from \"@amodeo/ui/util/ionic/use-card-modal/useCardModal\";",
      "import {",
      "  IonButton,",
      "  IonButtons,",
      "  IonContent,",
      "  IonHeader,",
      "  IonItem,",
      "  IonLabel,",
      "  IonModal,",
      "  IonTitle,",
      "  IonToolbar,",
      "} from \"@ionic/react\";",
      "import { useState } from \"react\";",
      "",
      "export const ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} = ({",
      "  modalProps,",
      "}: {",
      "  modalProps: ReturnType<typeof useCardModal>[\"modalProps\"];",
      "}) => {",
      "  const [isOpen, setIsOpen] = useState(false);",
      "",
      "  return (",
      "    <>",
      "      <IonItem onClick={() => setIsOpen(true)}>",
      "        <IonLabel>",
      "          <strong>${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}:</strong>",
      "        </IonLabel>",
      "      </IonItem>",
      "      <IonModal {...modalProps} isOpen={isOpen}>",
      "        <IonHeader>",
      "          <IonToolbar>",
      "            <IonTitle>${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}</IonTitle>",
      "            <IonButtons slot=\"end\">",
      "              <IonButton onClick={() => setIsOpen(false)}>Close</IonButton>",
      "            </IonButtons>",
      "          </IonToolbar>",
      "        </IonHeader>",
      "        <IonContent>",
      "          <div className=\"full centered\">This is a Modal</div>",
      "        </IonContent>",
      "      </IonModal>",
      "    </>",
      "  );",
      "};",
      "",
    ],
    "description": "Speaker select component with modal",
    "scope": "typescriptreact,javascriptreact",
  },

  "-Ionic Page": {
