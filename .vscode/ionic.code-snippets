  "-Ionic Toast": {
    "prefix": "ionic",
    "body": [
      "const [toast] = useIonToast();",
      "const [showLoading, hideLoading] = useIonLoading();",
      "",
      "const handleAsyncFunction = async () => {",
      "      await showLoading();",
      "      try {",
      "        const { data, error } = await // ASYNC FUNCTION HERE",
      "        if (error) throw error;",
      "        await hideLoading();",
      "        // SUCCESS FUNCTION HERE",
      "      } catch (error) {",
      "        // ERROR FUNCTION HERE",
      "        toast({",
      "            message: 'Sorry, something went wrong. Please try again.',",
      "            duration: 2000,",
      "            position: 'bottom',",
      "          });",
      "      }",
      "    };",
    ],
    "description": "description",
    "scope": "typescript,typescriptreact,javascript,javascriptreact,handlebars",
  },
