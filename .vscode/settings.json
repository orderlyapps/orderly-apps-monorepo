{
  "commands.workspaceCommands": {
    "~start": {
      "nestedItems": {
        "dev": {
          "sequence": [
            {
              "command": "commands.focusTerminal",
              "args": {
                "name": "dev"
              }
            },
            {
              "command": "workbench.action.terminal.kill"
            },
            {
              "command": "commands.runInTerminal",
              "args": {
                "text": " pnpm run dev:${input:app}",
                "reveal": true,
                "name": "dev",
                "reuse": "newest",
                "waitForExit": true
              },
              "inputs": [
                {
                  "type": "pickString",
                  "id": "app",
                  "description": "Which app to start?",
                  "options": ["proclaimer", "orderly"]
                }
              ]
            }
          ]
        },

        "deploy": {
          "sequence": [
            {
              "command": "commands.focusTerminal",
              "args": {
                "name": "deploy"
              }
            },
            {
              "command": "workbench.action.terminal.kill"
            },
            {
              "command": "commands.runInTerminal",
              "args": {
                "text": " pnpm run deploy:${input:app}",
                "reveal": true,
                "name": "deploy",
                "reuse": "newest",
                "waitForExit": true
              },
              "inputs": [
                {
                  "type": "pickString",
                  "id": "app",
                  "description": "Which app to deploy?",
                  "options": ["proclaimer", "orderly"]
                }
              ]
            }
          ]
        },

        "build": {
          "sequence": [
            {
              "command": "commands.focusTerminal",
              "args": {
                "name": "build"
              }
            },
            {
              "command": "workbench.action.terminal.kill"
            },
            {
              "command": "commands.runInTerminal",
              "args": {
                "text": " pnpm run build:${input:app}",
                "reveal": true,
                "name": "build",
                "reuse": "newest",
                "waitForExit": true
              },
              "inputs": [
                {
                  "type": "pickString",
                  "id": "app",
                  "description": "Which app to build?",
                  "options": ["proclaimer", "orderly"]
                }
              ]
            }
          ]
        },

        "commit": {
          "sequence": [
            {
              "command": "git.stageAll"
            },
            {
              "command": "commands.run",
              "args": [
                {
                  "command": "extension.conventionalCommits"
                }
              ]
            },
            {
              "command": "git.sync"
            }
          ]
        },

        "gen": {
          "sequence": [
            {
              "command": "commands.runInTerminal",
              "args": {
                "text": "turbo gen",
                "reveal": true
              }
            }
          ]
        },

        "snippets": {
          "command": "commands.run",
          "args": [
            {
              "command": "library-snippets"
            }
          ]
        }
      }
    },
    "library": {
      "nestedItems": {
        "library-snippets": {
          "nestedItems": {
            "react": {
              "command": "editor.action.insertSnippet",
              "args": {
                "name": "${input:snippet}"
              },
              "inputs": [
                {
                  "type": "pickString",
                  "id": "snippet",
                  "description": "Which wrap in fragment to use?",
                  "options": ["-Wrap in fragment","-React Component","-Map Array to List"]
                }
              ]
            }
          }
        }
      }
    }
  },
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],

  "editor.minimap.enabled": false,

  "explorerExclude.backup": {},
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".files": "*",
    "*.js": "${capture}.d.ts, ${capture}.d.ts.map",
    ".snippets": "*.code-snippets"
  },

  "files.autoSave": "afterDelay",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/node_modules": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/dev-dist": true,
    "**/turbo": true
  },
  "editor.linkedEditing": true
}
