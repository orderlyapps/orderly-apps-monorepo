{
  "commands.workspaceCommands": {
    "~start": {
      "nestedItems": {
        "dev": {
          "sequence": [
            {
              "command": "commands.focusTerminal",
              "args": {
                "name": "dev"
              }
            },
            {
              "command": "workbench.action.terminal.kill"
            },
            {
              "command": "commands.runInTerminal",
              "args": {
                "icon": "circle-filled",
                "iconColor": "charts.green",
                "text": " pnpm run dev:${input:app}",
                "reveal": true,
                "name": "dev",
                "reuse": "newest",
                "waitForExit": true
              },
              "inputs": [
                {
                  "type": "pickString",
                  "id": "app",
                  "description": "Which app to start?",
                  "options": ["orderly", "proclaimer"]
                }
              ]
            }
          ]
        },

        "deploy": {
          "sequence": [
            {
              "command": "commands.focusTerminal",
              "args": {
                "name": "deploy"
              }
            },
            {
              "command": "workbench.action.terminal.kill"
            },
            {
              "command": "commands.runInTerminal",
              "args": {
                "icon": "circle-filled",
                "iconColor": "charts.green",
                "text": " pnpm run deploy:${input:app}:${input:branch}",
                "reveal": true,
                "name": "deploy",
                "reuse": "newest",
                "waitForExit": true
              },
              "inputs": [
                {
                  "type": "pickString",
                  "id": "app",
                  "description": "Which app to deploy?",
                  "options": ["orderly", "proclaimer"]
                },
                {
                  "type": "pickString",
                  "id": "branch",
                  "description": "Which branch to deploy?",
                  "options": ["alpha", "beta", "production"]
                }
              ]
            }
          ]
        },

        "build": {
          "sequence": [
            {
              "command": "commands.focusTerminal",
              "args": {
                "name": "build"
              }
            },
            {
              "command": "workbench.action.terminal.kill"
            },
            {
              "command": "commands.runInTerminal",
              "args": {
                "icon": "circle-filled",
                "iconColor": "charts.green",
                "text": " pnpm run build:${input:app}",
                "reveal": true,
                "name": "build",
                "reuse": "newest",
                "waitForExit": true
              },
              "inputs": [
                {
                  "type": "pickString",
                  "id": "app",
                  "description": "Which app to build?",
                  "options": ["orderly", "proclaimer"]
                }
              ]
            }
          ]
        },

        "commit": {
          "sequence": [
            {
              "command": "git.stageAll"
            },
            {
              "command": "commands.run",
              "args": [
                {
                  "command": "extension.conventionalCommits"
                }
              ]
            },
            {
              "command": "git.sync"
            }
          ]
        },

        "gen": {
          "sequence": [
            {
              "command": "commands.runInTerminal",
              "args": {
                "reuse": "newest",
                "icon": "circle-filled",
                "iconColor": "charts.green",
                "text": "turbo gen",
                "name": "gen",
                "reveal": true
              }
            }
          ]
        },

        "snippets": {
          "command": "commands.run",
          "args": [
            {
              "command": "library-snippets"
            }
          ]
        },
        "import types from supabase": {
          "args": {
            "icon": "circle-filled",
            "iconColor": "charts.green",
            "reuse": "newest",
            "name": "supabase",
            "reveal": true,
            "text": "supabase gen types typescript --project-id qwshevjczcvmibztktuc > packages/data/src/supabase/exported-types-remote.ts"
          },
          "command": "commands.runInTerminal"
        }
      }
    },
    "library": {
      "nestedItems": {
        "library-snippets": {
          "nestedItems": {
            "react": {
              "command": "editor.action.insertSnippet",
              "args": {
                "name": "${input:snippet}"
              },
              "inputs": [
                {
                  "type": "pickString",
                  "id": "snippet",
                  "description": "Which wrap in fragment to use?",
                  "options": [
                    "-Wrap in Fragment",
                    "-Wrap in Conditional",
                    "-React Component",
                    "-Map Array to List"
                  ]
                }
              ]
            },
            "ionic": {
              "command": "editor.action.insertSnippet",
              "args": {
                "name": "${input:snippet}"
              },
              "inputs": [
                {
                  "type": "pickString",
                  "id": "snippet",
                  "description": "Which wrap in fragment to use?",
                  "options": ["-Ionic Modal"]
                }
              ]
            },
            "react-pdf": {
              "command": "editor.action.insertSnippet",
              "args": {
                "name": "${input:snippet}"
              },
              "inputs": [
                {
                  "type": "pickString",
                  "id": "snippet",
                  "description": "Which wrap in fragment to use?",
                  "options": ["-React PDF Component"]
                }
              ]
            }
          }
        }
      }
    }
  },
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],

  "editor.minimap.enabled": false,

  "explorerExclude.backup": {},
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".files": "*",
    "*.js": "${capture}.d.ts, ${capture}.d.ts.map",
    ".snippets": "*.code-snippets"
  },

  "files.autoSave": "afterDelay",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/dev-dist": true,
    "**/turbo": true,
    "**/.vscode": true,
    "**/.wrangler": true,
    "**/.files": true,
    "packages/config": true,
    "**/.zed": true,
    "**/.idea": true
  },
  "editor.linkedEditing": true,
  "workbench.editor.limit.enabled": true,
  "sqltools.connections": [
    {
      "pgOptions": {
        "ssl": {
          "rejectUnauthorized": true,
          "ca": "/Users/damianamodeo/Downloads/Miscellaneous/2025/03/prod-ca-2021.crt"
        }
      },
      "previewLimit": 50,
      "server": "aws-0-ap-southeast-2.pooler.supabase.com",
      "port": 6543,
      "driver": "PostgreSQL",
      "name": "orderly-dev",
      "password": "81a4Qe4ci0lVRmxF",
      "username": "postgres.qwshevjczcvmibztktuc",
      "database": "postgres"
    }
  ]
}
