create view public._view_weekend_meeting_schedule as
with
  weeks as (
    select distinct
      speaker_assignments.week_id
    from
      speaker_assignments
    union
    select distinct
      weekend_assignments.week_id
    from
      weekend_assignments
    union
    select distinct
      weekend_meeting_data.w_study_date as week_id
    from
      weekend_meeting_data
  )
select
  w.week_id,
  c.id as congregation_id,
  row_to_json(c.*) as congregation,
  row_to_json(wmd.*) as weekend_meeting_data,
  row_to_json(pc.*) as chairman,
  row_to_json(pr.*) as reader,
  COALESCE(
    array_agg(
      distinct jsonb_build_object(
        'speaker',
        row_to_json(op.*),
        'outline',
        row_to_json(oo.*),
        'congregation',
        row_to_json(oc.*)
      )
    ) filter (
      where
        op.id is not null
    ),
    null::jsonb[]
  ) as speakers
from
  congregations c
  cross join weeks w
  left join weekend_meeting_data wmd on w.week_id = wmd.w_study_date
  left join speaker_assignments os on w.week_id = os.week_id
  left join _view_publishers_simple op on os.speaker_id = op.id
  left join congregations oc on oc.id = os.congregation_id
  left join outlines oo on oo.id = os.outline_id
  left join weekend_assignments wac on wac.congregation_id = c.id
  and wac.week_id = w.week_id
  and wac.assignment = 'chairman'::weekend_assignment
  left join publishers pc on pc.id = wac.participant_id
  left join weekend_assignments war on war.congregation_id = c.id
  and war.week_id = w.week_id
  and war.assignment = 'reader'::weekend_assignment
  left join publishers pr on pr.id = war.participant_id
group by
  w.week_id,
  wmd.*,
  pc.*,
  pr.*,
  c.id;

  create drop view public._midweek_meeting_participants as
select
  p.id,
  p.first_name,
  p.last_name,
  p.congregation_id,
  json_agg(distinct mp.assignment) as participation,
  case
    when count(ma.*) = 0 then null::json
    else json_agg(
      jsonb_build_object(
        'week_id',
        ma.week_id,
        'assignment',
        ma.assignment
      )
    )
  end as midweek_assignments
from
  publishers p
  join midweek_participants mp on mp.participant_id = p.id
  join midweek_assignments ma on p.id = ma.participant_id
where
  ma.week_id >= (CURRENT_DATE - '1 year'::interval)
group by
  p.id,
  p.first_name,
  p.last_name,
  p.congregation_id;

  create drop view public._view_publishers_simple as
select
  p.id,
  p.first_name,
  p.last_name,
  p.congregation_id,
  c.name as congregation_name
from
  publishers p
  left join congregations c on c.id = p.congregation_id;






