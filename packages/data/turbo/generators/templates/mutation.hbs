import { useMutation, useQueryClient } from "@tanstack/react-query";
import { supabase } from "../../../supabase/client.js";
import { TablesUpdate } from "../../../supabase/supabase-types.js";

export const {{camelCase name}} = () => {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: async (newData: TablesUpdate<"midweek_assignments">) => {
      const { data, error } = await supabase
        .from("midweek_assignments")
        .update({
          ...newData,
          congregation_id: "a42cc43a-562f-4ed4-ac74-73dfdb42aaa5",
        })
        .select();

      if (error) {
        throw new Error(error.message);
      }
      return data;
    },
    onSuccess: (_data, variables, _context) => {
      console.log(
        "🚀 ~ useUpsertAssignmentsMidweekPartsMutation ~ variables:",
        variables
      );

      queryClient.invalidateQueries({
        queryKey: ["schedule"],
      });
    },
  });
};
