{
  "name": "@amodeo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./util/*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./src/*.tsx",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "devDependencies": {
    "@amodeo/config": "workspace:^",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.1",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@amodeo/data": "workspace:^",
    "@amodeo/util": "workspace:^",
    "date-fns": "^4.1.0",
    "ionicons": "^7.4.0"
  },
  "peerDependencies": {
    "@ionic/react": "*",
    "@ionic/react-router": "*",
    "react": "*",
    "react-dom": "*",
    "react-router": "*",
    "react-router-dom": "*"
  }
